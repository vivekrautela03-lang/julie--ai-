# =============================================================================
# PROJECT JULIE — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local for local development. Never commit real keys.
# =============================================================================

# Application Configuration
VITE_APP_NAME=Julie
VITE_APP_ENV=development
VITE_ENABLE_DEMO_MODE=true

# Supabase Backend Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Provider API Keys (Supports Google Gemini, OpenAI, Anthropic)
VITE_AI_PROVIDER=gemini
VITE_AI_API_KEY=your_gemini_or_openai_api_key_here
VITE_AI_MODEL=gemini-1.5-pro

# Speech-to-Text & Text-to-Speech Providers (Web Speech API by default)
VITE_STT_PROVIDER=web_speech
VITE_TTS_PROVIDER=web_speech
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=

# University ERP Connector Integration (Configurable per institution)
VITE_ERP_API_BASE_URL=https://erp.apex-university.edu/api/v1
VITE_ERP_CLIENT_ID=julie_mobile_client_01
VITE_ERP_CLIENT_SECRET=

# Google Calendar Integration (Optional)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
